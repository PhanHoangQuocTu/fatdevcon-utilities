{
  "name": "@fatdevcon/utilities",
  "version": "0.1.06",
  "description": "A TypeScript utility library for calculations and formatting",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "utilities",
    "typescript",
    "calculations",
    "formatting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "install": "^0.13.0",
    "npm": "^11.5.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.1",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PhanHoangQuocTu/-fatdevcon-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/PhanHoangQuocTu/-fatdevcon-utilities/issues"
  },
  "homepage": "https://github.com/PhanHoangQuocTu/-fatdevcon-utilities#readme",
  "publishConfig": {
    "access": "public"
  }
}