{
  "name": "@fatdevcon/utilities",
  "version": "0.2.2",
  "description": "TypeScript utilities for math, Unicode text, locale-aware numbers, currencies, arrays and objects",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "rollup --config rollup.config.mjs",
    "dev": "tsup --watch --onSuccess \"npm run build:types\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "npm run check && npm run test:package",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:bun": "bun test",
    "test:tarball": "node scripts/verify-tarball.mjs",
    "prepack": "npm run build",
    "audit": "npm audit --audit-level=low"
  },
  "keywords": [
    "utilities",
    "typescript",
    "calculations",
    "formatting",
    "currency",
    "math",
    "array",
    "object",
    "locale",
    "date",
    "number",
    "text",
    "bun",
    "npm",
    "yarn",
    "pnpm",
    "unicode",
    "commonjs",
    "esm",
    "cjs",
    "mjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhanHoangQuocTu/fatdevcon-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/PhanHoangQuocTu/fatdevcon-utilities/issues"
  },
  "homepage": "https://github.com/PhanHoangQuocTu/fatdevcon-utilities#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false
  },
  "overrides": {
    "sucrase": {
      "glob": "^13.0.6"
    },
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
