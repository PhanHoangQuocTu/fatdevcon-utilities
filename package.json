{
  "name": "@fatdevcon/utilities",
  "version": "0.2.1",
  "description": "TypeScript utilities for math, Unicode text, locale-aware numbers, currencies, arrays and objects",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run test:package",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:bun": "bun test",
    "test:tarball": "node scripts/verify-tarball.mjs"
  },
  "keywords": [
    "utilities",
    "typescript",
    "calculations",
    "formatting",
    "currency",
    "math",
    "array",
    "object",
    "locale",
    "date",
    "number",
    "text",
    "bun",
    "npm",
    "yarn",
    "pnpm",
    "unicode",
    "commonjs",
    "esm",
    "cjs",
    "mjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.1",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhanHoangQuocTu/-fatdevcon-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/PhanHoangQuocTu/-fatdevcon-utilities/issues"
  },
  "homepage": "https://github.com/PhanHoangQuocTu/-fatdevcon-utilities#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  }
}
