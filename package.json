{
  "name": "@fatdevcon/utilities",
  "version": "0.4.0",
  "description": "Zero-dependency TypeScript utilities: exact decimal and bigint math, calendar/date helpers, SSR-safe runtime detection, formatting, collections, Unicode text, safe objects and async tools",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "rollup --config rollup.config.mjs",
    "dev": "tsup --watch --onSuccess \"npm run build:types\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "npm run check && npm run docs:sync && npm run test:package && npm run test:docs && npm run test:site",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:bun": "bun test src/__tests__/numeric.test.ts src/__tests__/differential.test.ts src/__tests__/edge-cases.test.ts src/__tests__/oracle-decimal.test.ts src/__tests__/oracle-date.test.ts src/__tests__/index.test.ts src/__tests__/formatter.test.ts",
    "test:tarball": "node scripts/verify-tarball.mjs",
    "prepack": "npm run build",
    "audit": "npm audit --audit-level=low --omit=dev",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "docs:sync": "node scripts/sync-docs.mjs"
  },
  "keywords": [
    "typescript",
    "javascript",
    "utilities",
    "utils",
    "utility-library",
    "lodash-alternative",
    "zero-dependency",
    "tree-shakeable",
    "esm",
    "commonjs",
    "nodejs",
    "bun",
    "browser",
    "decimal",
    "decimal-math",
    "exact-arithmetic",
    "floating-point",
    "precision",
    "bigint",
    "big-number",
    "arbitrary-precision",
    "decimal-js-alternative",
    "money",
    "rounding",
    "format-currency",
    "format-number",
    "format-bytes",
    "parse-bytes",
    "format-duration",
    "parse-duration",
    "intl",
    "iso-4217",
    "currency",
    "date",
    "timezone",
    "time-zone",
    "iana-timezone",
    "utc-offset",
    "dst",
    "format-date",
    "date-fns-alternative",
    "iso-8601",
    "relative-time",
    "text",
    "unicode",
    "emoji",
    "truncate",
    "slugify",
    "vietnamese",
    "camelcase",
    "array",
    "object",
    "group-by",
    "deep-clone",
    "deep-merge",
    "debounce",
    "throttle",
    "memoize",
    "retry",
    "validator",
    "algorithms",
    "typescript-utilities",
    "date-utils",
    "array-helpers",
    "runtime-detection",
    "ssr"
  ],
  "author": {
    "name": "PhanHoangQuocTu",
    "url": "https://github.com/PhanHoangQuocTu"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhanHoangQuocTu/fatdevcon-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/PhanHoangQuocTu/fatdevcon-utilities/issues"
  },
  "homepage": "https://phanhoangquoctu.github.io/fatdevcon-utilities/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false
  },
  "overrides": {
    "sucrase": {
      "glob": "^13.0.6"
    },
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
