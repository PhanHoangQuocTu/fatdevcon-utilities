{
  "name": "@fatdevcon/utilities",
  "version": "0.3.4",
  "description": "TypeScript utilities with exact big-number math, timezone/date formatting, collections, cancellable waits, retries and validators",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "rollup --config rollup.config.mjs",
    "dev": "tsup --watch --onSuccess \"npm run build:types\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "npm run check && npm run test:package && npm run test:docs && npm run test:site",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:bun": "bun test",
    "test:tarball": "node scripts/verify-tarball.mjs",
    "prepack": "npm run build",
    "audit": "npm audit --audit-level=low",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:site": "node scripts/verify-site.mjs"
  },
  "keywords": [
    "utilities",
    "utils",
    "helpers",
    "typescript",
    "javascript",
    "nodejs",
    "bun",
    "formatting",
    "format-number",
    "format-currency",
    "format-date",
    "format-bytes",
    "compact-number",
    "percent",
    "intl",
    "i18n",
    "locale",
    "currency",
    "currency-symbol",
    "iso-4217",
    "cldr",
    "number",
    "date",
    "timezone",
    "time-zone",
    "iana-timezone",
    "utc-offset",
    "timezone-offset",
    "offset-seconds",
    "offset-hours",
    "daylight-saving",
    "dst",
    "text",
    "string",
    "unicode",
    "grapheme",
    "emoji",
    "truncate",
    "slugify",
    "mask",
    "diacritics",
    "vietnamese",
    "math",
    "calculations",
    "decimal",
    "precision",
    "array",
    "object",
    "group-by",
    "chunk",
    "deep-clone",
    "algorithms",
    "sorting",
    "binary-search",
    "esm",
    "commonjs",
    "cjs",
    "mjs",
    "tree-shakeable",
    "npm",
    "yarn",
    "pnpm",
    "utility-library",
    "lodash-alternative",
    "typed-utils",
    "string-utils",
    "array-utils",
    "object-utils",
    "date-utils",
    "camelcase",
    "kebab-case",
    "snake-case",
    "pascalcase",
    "title-case",
    "case-converter",
    "escape-html",
    "word-count",
    "relative-time",
    "time-ago",
    "format-duration",
    "debounce",
    "throttle",
    "memoize",
    "retry",
    "with-retry",
    "abort",
    "abort-signal",
    "abort-controller",
    "abort-error",
    "cancellation",
    "cancellable",
    "cancelable",
    "timeout",
    "promise",
    "sleep",
    "deep-merge",
    "deep-equal",
    "pick",
    "omit",
    "get-by-path",
    "clamp",
    "median",
    "shuffle",
    "range",
    "partition",
    "difference",
    "intersection",
    "validation",
    "validator",
    "email-validation",
    "url-validation",
    "uuid",
    "bignumber",
    "bigint",
    "big-number",
    "bigdecimal",
    "arbitrary-precision",
    "decimal-math",
    "precise-math",
    "floating-point",
    "big-factorial",
    "fibonacci",
    "prime",
    "miller-rabin",
    "gcd",
    "lcm",
    "rounding",
    "half-even",
    "bankers-rounding",
    "money",
    "financial",
    "compare-numbers",
    "numeric-string",
    "overflow",
    "modulo",
    "power"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhanHoangQuocTu/fatdevcon-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/PhanHoangQuocTu/fatdevcon-utilities/issues"
  },
  "homepage": "https://phanhoangquoctu.github.io/fatdevcon-utilities/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false
  },
  "overrides": {
    "sucrase": {
      "glob": "^13.0.6"
    },
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
